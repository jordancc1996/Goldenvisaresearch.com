---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import EmptyState from "../archive/EmptyState.astro";
import StoryRow from "../archive/StoryRow.astro";
import { formatArticleDate, isoDate } from "../../lib/article-display";
import { isImageMetadata } from "../../lib/image-metadata";
import type { ArchiveStory } from "../../lib/archive";

interface Props {
  name: string;
  role: string;
  summary: string;
  expertise: string[];
  linkedin?: string;
  disclosures?: string;
  hasBody: boolean;
  photo?: { src: ImageMetadata; alt: string; credit: string };
  articles: ArchiveStory[];
  reviews: { href: string; title: string; reviewedOn: Date }[];
  indexed?: boolean;
  kicker?: string;
  note?: string;
}

const { name, role, summary, expertise, linkedin, disclosures, hasBody, photo, articles, reviews, indexed = false, kicker = "Author", note } = Astro.props;
const photoSrc = photo && isImageMetadata(photo.src) ? photo.src : undefined;
---

<div class="archive-page shell-wrap author-profile" data-pagefind-body={indexed ? true : undefined}>
  <header class="article-header">
    <p class="type-kicker article-kicker">{kicker}</p>
    {note && <p class="design-notice">{note}</p>}
    <h1 class="article-title">{name}</h1>
    <p class="author-role">{role}</p>
    <p class="article-dek">{summary}</p>
  </header>
  {
    photoSrc && photo && (
      <figure class="author-photo">
        <Image
          src={photoSrc}
          alt={photo.alt}
          widths={[240, 480]}
          sizes="160px"
          format="webp"
          loading="eager"
          decoding="async"
        />
        <figcaption>{photo.credit}</figcaption>
      </figure>
    )
  }
  <section class="topic-section" aria-labelledby="author-biography">
    <h2 id="author-biography">Biography</h2>
    {hasBody ? <div class="author-biography"><slot /></div> : <p>No biography is recorded.</p>}
  </section>
  <section class="topic-section" aria-labelledby="author-expertise">
    <h2 id="author-expertise">Expertise</h2>
    {
      expertise.length === 0 ? (
        <EmptyState message="No areas of expertise are recorded." />
      ) : (
        <ul class="author-expertise">
          {expertise.map((item) => <li>{item}</li>)}
        </ul>
      )
    }
  </section>
  {
    linkedin && (
      <p class="topic-more">
        <a class="text-link" href={linkedin} rel="noopener noreferrer">LinkedIn</a>
      </p>
    )
  }
  <section class="topic-section" aria-labelledby="author-articles">
    <h2 id="author-articles">Articles</h2>
    {
      articles.length === 0 ? (
        <EmptyState message="No articles are published." />
      ) : (
        <ol class="story-rows">
          {articles.map((story) => (
            <StoryRow
              href={story.href}
              kicker={story.categoryLabel}
              title={story.title}
              summary={story.summary}
              publishedAt={story.publishedAt}
              countries={story.countries}
              level={3}
            />
          ))}
        </ol>
      )
    }
  </section>
  {
    reviews.length > 0 && (
      <section class="topic-section" aria-labelledby="author-reviews">
        <h2 id="author-reviews">Reviews</h2>
        <ul class="topic-countries">
          {reviews.map((review) => (
            <li>
              <a href={review.href}>{review.title}</a>
              <span>
                Reviewed <time datetime={isoDate(review.reviewedOn)}>{formatArticleDate(review.reviewedOn)}</time>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="topic-section" aria-labelledby="author-disclosures">
    <h2 id="author-disclosures">Disclosures</h2>
    <p>{disclosures ?? "No disclosures are recorded."}</p>
  </section>
</div>
