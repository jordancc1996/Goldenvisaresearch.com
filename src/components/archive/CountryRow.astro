---
import { isoDate } from "../../lib/article-display";

interface Props {
  href: string;
  name: string;
  region: string;
  programCountLabel: string;
  statusLabels: string[];
  verifiedLabel: string;
  verifiedOn?: Date;
}

const { href, name, region, programCountLabel, statusLabels, verifiedLabel, verifiedOn } = Astro.props;
---

<li class="country-row" data-country-row data-name={name} data-region={region}>
  <h3 class="story-title">
    <a href={href}>{name}</a>
  </h3>
  <p class="story-meta">{programCountLabel}</p>
  <p class="story-meta">Status: {statusLabels.length > 0 ? statusLabels.join(", ") : "No status recorded"}</p>
  <p class="story-meta">
    Last verified:{" "}
    {verifiedOn ? <time datetime={isoDate(verifiedOn)}>{verifiedLabel}</time> : verifiedLabel}
  </p>
</li>
