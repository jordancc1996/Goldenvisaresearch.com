---
import { formatArticleDate, isoDate } from "../../lib/article-display";
import "../../styles/trust.css";
import type { CorrectionRecord } from "../../lib/corrections";

interface Props {
  items: { id: string; data: CorrectionRecord }[];
  logLink?: boolean;
}

const { items, logLink = false } = Astro.props;
---

{
  items.length === 0 ? (
    <p>No corrections are recorded.</p>
  ) : (
    <ol class="correction-log">
      {items.map((item) => (
        <li>
          <h3>{item.data.title}</h3>
          <p>
            <time datetime={isoDate(item.data.publishedAt)}>{formatArticleDate(item.data.publishedAt)}</time>
            {" · "}
            <a href={item.data.path}>{item.data.path}</a>
          </p>
          <p>{item.data.summary}</p>
          <p>Previous: {item.data.previous}</p>
          <p>Corrected: {item.data.corrected}</p>
          {item.data.source && (
            <p>
              Source: <a href={item.data.source.url}>{item.data.source.label}</a>
            </p>
          )}
        </li>
      ))}
    </ol>
  )
}
{logLink && (
  <p class="trust-more">
    <a class="text-link" href="/corrections">Corrections log</a>
  </p>
)}
