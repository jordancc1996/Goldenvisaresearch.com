---
interface Props {
  links: { href: string; title: string }[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="article-section" id="supporting-records" aria-labelledby="supporting-records-title">
      <h2 id="supporting-records-title">Supporting records</h2>
      <ul class="supporting-list">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}
