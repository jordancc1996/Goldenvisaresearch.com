---
import { canonicalUrl } from "../../data/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const encodedUrl = canonical ? encodeURIComponent(canonical) : "";
const encodedTitle = encodeURIComponent(title);
const icons: Record<string, string> = {
  email:
    '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M1.5 3.5h13v9h-13v-9zm1.2.8 5.3 3.7 5.3-3.7H2.7zm10.6 7.4V5.4L8 9.1 2.7 5.4v6.3h10.6z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3.4 6.2H1.2V14h2.2V6.2zM2.3 2C1.6 2 1 2.6 1 3.3s.6 1.3 1.3 1.3 1.3-.6 1.3-1.3S3 2 2.3 2zM14.8 9.3c0-2.2-1.2-3.2-2.7-3.2-1.3 0-1.8.7-2.1 1.2V6.2H7.8c0 1.5 0 7.8 0 7.8h2.2V9.6c0-.2 0-.5.1-.7.2-.5.7-1 1.5-1 1.1 0 1.5.8 1.5 2V14h2.2V9.3z"/></svg>',
  x: '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M9.2 7.1 13.6 2H12.4L8.7 6.3 5.7 2H2.2l4.6 6.7L2.2 14h1.2l4-4.7 3.2 4.7h3.5L9.2 7.1zm-1.4 1.7-.5-.7L3.8 2.8h1.6l3 4.3.5.7 3.9 5.6H11.2L7.8 8.8z"/></svg>',
  facebook:
    '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M9.4 14V8.7h1.8l.3-2.1H9.4V5.3c0-.6.2-1 1-1h1.1V2.4C11.3 2.4 10.6 2.3 9.8 2.3 8.1 2.3 7 3.3 7 5.1v1.5H5.2v2.1H7V14h2.4z"/></svg>',
};
const items = canonical
  ? [
      { label: "Email", icon: "email", href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`, external: false },
      {
        label: "LinkedIn",
        icon: "linkedin",
        href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
        external: true,
      },
      {
        label: "X",
        icon: "x",
        href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
        external: true,
      },
      {
        label: "Facebook",
        icon: "facebook",
        href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
        external: true,
      },
    ]
  : [
      { label: "Email", icon: "email" },
      { label: "LinkedIn", icon: "linkedin" },
      { label: "X", icon: "x" },
      { label: "Facebook", icon: "facebook" },
    ];
---

<div class="share-block" data-pagefind-ignore>
  <ul class="share-bar" aria-label="Share this article">
    {
      items.map((item) => (
        <li>
          {"href" in item && item.href ? (
            <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
              <span class="share-icon" set:html={icons[item.icon]} />
              <span>{item.label}</span>
            </a>
          ) : (
            <button type="button" aria-disabled="true">
              <span class="share-icon" set:html={icons[item.icon]} />
              <span>{item.label}</span>
            </button>
          )}
        </li>
      ))
    }
  </ul>
  {!canonical && <p class="share-note">Sharing is preview-only until a public address exists.</p>}
</div>
