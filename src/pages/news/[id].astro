---
import ArticleView from "../../components/article/ArticleView.astro";
import { articlePaths } from "../../lib/load-article";

export async function getStaticPaths() {
  return articlePaths("news");
}

const id = Astro.params.id;
if (!id) throw new Error("Missing news id");
---

<ArticleView collection="news" id={id} />
