---
import NewsArchive from "../../../../components/archive/NewsArchive.astro";
import { newsPagePaths } from "../../../../lib/load-archive";

export async function getStaticPaths() {
  return newsPagePaths("regulation");
}

const page = Number(Astro.params.page);
if (!Number.isInteger(page) || page < 2) throw new Error("Missing regulation page");
---

<NewsArchive category="regulation" page={page} />
