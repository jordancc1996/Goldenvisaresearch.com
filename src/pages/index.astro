---
import { getCollection } from "astro:content";
import DesignNotice from "../components/home/DesignNotice.astro";
import HomeNewsletter from "../components/home/HomeNewsletter.astro";
import HomeResearch from "../components/home/HomeResearch.astro";
import HomeTracker from "../components/home/HomeTracker.astro";
import LatestNews from "../components/home/LatestNews.astro";
import Opening from "../components/home/Opening.astro";
import RegionIndex from "../components/home/RegionIndex.astro";
import StandardsNote from "../components/home/StandardsNote.astro";
import TopicCoverage from "../components/home/TopicCoverage.astro";
import { site } from "../data/site";
import { buildDirectoryRows, sortDirectory } from "../lib/directory";
import { composeHome } from "../lib/home-edition";
import { routeIndexable } from "../lib/indexability";
import { loadHomeNews, loadHomeReports } from "../lib/load-archive";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/edition.css";
import "../styles/home.css";

const news = await loadHomeNews();
const reports = await loadHomeReports();
const edition = composeHome(news, reports);
const programs = await getCollection("programs");
const countries = await getCollection("countries");
const directory = buildDirectoryRows(programs, countries, "production");
const trackerRows = sortDirectory(directory.rows, "verified");
const desk = news.some((story) => story.desk) || reports.some((story) => story.desk);
---

<BaseLayout title={site.name} description={site.description} siteSchema={true} noindex={!routeIndexable("/")}>
  <div class="home">
    {desk && (
      <div class="shell-wrap home-preview-note">
        <DesignNotice show />
      </div>
    )}
    <Opening lead={edition.lead} secondary={edition.secondary} />
    <LatestNews stories={edition.latest} />
    {edition.topics.map((topic) => <TopicCoverage topic={topic} />)}
    <HomeResearch stories={edition.research} />
    <HomeTracker rows={trackerRows} />
    <RegionIndex />
    <StandardsNote />
    <HomeNewsletter />
  </div>
</BaseLayout>
