---
import ArticleView from "../../components/article/ArticleView.astro";
import { articlePaths } from "../../lib/load-article";

export async function getStaticPaths() {
  return articlePaths("programs");
}

const id = Astro.params.id;
if (!id) throw new Error("Missing program id");
---

<ArticleView collection="programs" id={id} />
