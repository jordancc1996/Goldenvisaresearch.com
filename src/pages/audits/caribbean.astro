---
import AuditIndex from "../../components/audits/AuditIndex.astro";
import { auditRegionPages } from "../../data/audits";
import { auditsInRegion, loadAudits } from "../../lib/load-audits";

const page = auditRegionPages[0];
const stories = auditsInRegion(await loadAudits(), page.region);
---

<AuditIndex
  title={page.title}
  h1={page.h1}
  description={page.description}
  stories={stories}
  showTypes
  showRequest
  showAll={false}
/>
