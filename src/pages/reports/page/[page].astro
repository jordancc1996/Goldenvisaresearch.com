---
import ResearchArchive from "../../../components/archive/ResearchArchive.astro";
import { reportPagePaths } from "../../../lib/load-archive";

export async function getStaticPaths() {
  return reportPagePaths();
}

const page = Number(Astro.params.page);
if (!Number.isInteger(page) || page < 2) throw new Error("Missing research page");
---

<ResearchArchive page={page} />
