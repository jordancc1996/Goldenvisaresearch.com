---
import ResearchArchive from "../../../../components/archive/ResearchArchive.astro";
import { reportPagePaths } from "../../../../lib/load-archive";

export async function getStaticPaths() {
  return reportPagePaths("country-research");
}

const page = Number(Astro.params.page);
if (!Number.isInteger(page) || page < 2) throw new Error("Missing country research page");
---

<ResearchArchive type="country-research" page={page} />
