---
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import sourceSerifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { canonicalUrl, site } from "../data/site";
import { jsonLd, publicationGraph, robotsDirectiveFor } from "../lib/metadata";
import type { Crumb } from "../data/navigation";
import SiteShell from "../components/shell/SiteShell.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: Crumb[];
  prev?: string;
  next?: string;
  kind?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  siteSchema?: boolean;
  indexed?: boolean;
}

const {
  title,
  description,
  noindex = false,
  crumbs = [],
  prev,
  next,
  kind = "website",
  publishedAt,
  updatedAt,
  siteSchema = false,
  indexed = false,
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const robots = robotsDirectiveFor({ dev: import.meta.env.DEV, origin: site.origin }, !noindex);
const graph = siteSchema ? jsonLd(publicationGraph(site.origin)) : null;
const published = publishedAt?.toISOString();
const modified = updatedAt?.toISOString();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={sourceSerifLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={kind === "article" ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {kind === "article" && published && <meta property="article:published_time" content={published} />}
    {kind === "article" && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {graph && <script is:inline type="application/ld+json" set:html={graph} />}
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="generator" content={Astro.generator} />
    {
      site.origin && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={site.name}
          href={new URL("/rss.xml", site.origin).href}
        />
      )
    }
  </head>
  <body data-pagefind-ignore={indexed ? undefined : "all"}>
    <SiteShell crumbs={crumbs}>
      <slot />
    </SiteShell>
  </body>
</html>
